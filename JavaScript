// 1. Konfigurasi SDK Firebase Realtime Database Anda
import { initializeApp } from "https://gstatic.com";
import { getDatabase, ref, set, onValue } from "https://gstatic.com";

const firebaseConfig = {
  apiKey: "AIzaSyAP06GuqBy4RIfDa3ngshksvnrfWcn09l8",
  authDomain: "://firebaseapp.com",
  databaseURL: "https://firebasedatabase.app",
  projectId: "smart-power-meter-f72c9",
  storageBucket: "smart-power-meter-f72c9.firebasestorage.app",
  messagingSenderId: "331580059264",
  appId: "1:331580059264:web:07dcc54bbcbabb22afc065",
  measurementId: "G-VVETL2YN4Q"
};

// Inisialisasi Firebase
const app = initializeApp(firebaseConfig);
const database = getDatabase(app);

// ==========================================
// A. MEMBACA DATA SENSOR SECARA REAL-TIME
// ==========================================
// Mengambil data dari path /pzem/sensor sesuai kode ESP32 baru
const sensorRef = ref(database, 'pzem/sensor');

onValue(sensorRef, (snapshot) => {
  const data = snapshot.val();
  if (data) {
    // Update elemen text di HTML dashboard Anda (sesuaikan ID elemennya)
    document.getElementById("txt-tegangan").innerText = data.voltage + " V";
    document.getElementById("txt-arus").innerText = data.current + " A";
    document.getElementById("txt-daya").innerText = data.power + " W";
    document.getElementById("txt-frekuensi").innerText = data.frequency + " Hz";
    document.getElementById("txt-energi").innerText = data.energy + " kWh";
    
    // Menampilkan status relay yang dilaporkan balik oleh ESP32
    document.getElementById("txt-status-relay").innerText = "SISTEM: " + data.relay;
  }
});

// ==========================================
// B. FUNGSI TOMBOL KONTROL ON/OFF (KIRIM PERINTAH)
// ==========================================
// Mengirim perintah string murni "ON" atau "OFF" ke path /pzem/control
function kirimPerintahRelay(statusPerintah) {
  const controlRef = ref(database, 'pzem/control');
  
  // Menggunakan fungsi set() untuk menulis teks langsung tanpa format JSON objek
  set(controlRef, statusPerintah)
    .then(() => {
      console.log("Perintah " + statusPerintah + " berhasil dikirim ke ESP32.");
    })
    .catch((error) => {
      console.error("Gagal mengirim perintah: ", error);
    });
}

// Elemen Event Listener Tombol di HTML Anda
// Contoh jika Anda menggunakan dua tombol terpisah di UI web:
document.getElementById("btn-on").addEventListener("click", () => {
  kirimPerintahRelay("ON");
});

document.getElementById("btn-off").addEventListener("click", () => {
  kirimPerintahRelay("OFF");
});
